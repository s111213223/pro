GEMINI_API_KEY=
# Multimodal model for bbox (see https://ai.google.dev/gemini-api/docs/models )
# If you see 429 / "limit: 0" on one model, try: gemini-2.5-flash-lite | gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash
# Set to 1 only if you intentionally need gemini-2.0-flash (otherwise the API remaps 2.0 -> 2.5)
# GEMINI_ALLOW_2_0_FLASH=0
# Comma-separated origins for Flutter web (optional)
# CORS_ORIGINS=http://localhost:53539,http://127.0.0.1:53539
